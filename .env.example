# Contact form — app/api/contact/route.ts
#
# Without both of these the endpoint returns 503 and the form falls back to
# showing the email address directly. That is deliberate: a form that accepts a
# message and silently drops it is worse than no form.
#
# Setup (about 3 minutes):
#   1. Sign up at https://resend.com  (free, 3,000 emails/month)
#   2. API Keys -> Create API Key -> copy it
#   3. Copy this file to .env.local and fill both values
#   4. In Vercel: Settings -> Environment Variables -> add both -> redeploy
#
# No domain verification needed. The route sends from onboarding@resend.dev,
# with reply-to set to whoever filled in the form, so replying just works.

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=tousifarsen@gmail.com
